# Copia este fichero a terraform.tfvars y rellena los valores.
# terraform.tfvars esta en .gitignore: NUNCA lo versiones.

# Clave publica que cloud-init inyecta en las VMs (usuario "ansible") y en el
# root de los LXC. Normalmente, la de ctrl01:
#   cat ~/.ssh/id_ed25519.pub
ci_ssh_key = "ssh-ed25519 AAAA...tu-clave... ctrl01-netseg"

# Overrides opcionales (los defaults estan en variables.tf):
# node_name  = "pve01"
# lab_bridge = "vmbr2"
# vm_storage = "local-lvm"
